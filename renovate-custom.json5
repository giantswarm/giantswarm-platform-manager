// Repo-specific Renovate rules; renovate.json5 (generated) extends this file.
{
  packageRules: [
    {
      // The render-consumption test (render/agentplatform/testdata/consumption/
      // charts.yaml) renders the agent-platform meta chart on both of its lines,
      // one pin per line: the 3 line's pin follows the 3 line (the fleet base caps
      // it <4.0.0), the 4 line's pin the 4 line. The pins are docker tags to
      // Renovate and docker versioning knows no ranges, so a range in
      // matchCurrentVersion never matches and the rule is skipped: the lines are
      // told apart by a regex over the current version. The connectivity chart is
      // released with the meta chart at the same version and the meta chart pins
      // it at its own, so the two are one group per line: one pull request bumps
      // both, since a bump of one alone can never pass the test.
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'gsoci.azurecr.io/charts/giantswarm/agent-platform',
        'gsoci.azurecr.io/charts/giantswarm/agent-platform-connectivity',
      ],
      matchCurrentVersion: '/^3\\./',
      allowedVersions: '/^3\\./',
      groupName: 'agent-platform 3 line',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'gsoci.azurecr.io/charts/giantswarm/agent-platform',
        'gsoci.azurecr.io/charts/giantswarm/agent-platform-connectivity',
      ],
      matchCurrentVersion: '/^4\\./',
      allowedVersions: '/^4\\./',
      groupName: 'agent-platform 4 line',
      separateMajorMinor: false,
    },
    {
      // The 4 line's children are pinned at the newest versions inside the
      // ranges the meta chart's 4 line pin declares for them, so a bump of the
      // meta chart that moves a range and a bump of a child alone can each fail
      // the test: they are one group with the meta chart and one pull request moves
      // them together. Where a child's newest release is outside the new range, the
      // test's failure names the version to pin. A child's major is the exception
      // (the rule after the agent-manager one): it leaves the group.
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'gsoci.azurecr.io/giantswarm/kagent/helm/kagent',
        'gsoci.azurecr.io/charts/giantswarm/klaus-gateway',
        'gsoci.azurecr.io/charts/giantswarm/model-manager',
        'gsoci.azurecr.io/charts/giantswarm/agentgateway',
        'gsoci.azurecr.io/charts/giantswarm/cluster-manager',
        'gsoci.azurecr.io/charts/giantswarm/kserve-llmisvc-crd',
        'gsoci.azurecr.io/charts/giantswarm/kserve-llmisvc-resources',
        'gsoci.azurecr.io/charts/giantswarm/kserve-runtime-configs',
        'gsoci.azurecr.io/charts/giantswarm/agent-platform-operator',
        'gsoci.azurecr.io/charts/giantswarm/skill-manager',
      ],
      groupName: 'agent-platform 4 line',
      separateMajorMinor: false,
    },
    {
      matchDatasources: ['docker'],
      matchPackageNames: ['gsoci.azurecr.io/giantswarm/kagent/helm/kagent'],
      versioning: 'semver',
      allowedVersions: '>=1.31.0 <1.32.0',
    },
    {
      // agent-manager is pinned per line too: the 3 line's meta chart follows
      // 0.x, the 4 line's 1.x and newer, which moves with the 4 line's group.
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'gsoci.azurecr.io/charts/giantswarm/agent-manager',
      ],
      matchCurrentVersion: '/^0\\./',
      allowedVersions: '/^0\\./',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'gsoci.azurecr.io/charts/giantswarm/agent-manager',
      ],
      matchCurrentVersion: '!/^0\\./',
      groupName: 'agent-platform 4 line',
      separateMajorMinor: false,
    },
    {
      // A child's new major lies outside the range the meta chart's 4 line pin
      // declares (agent-manager 3.x against >=2.3.0 <3.0.0), so it fails the
      // test on every bump until pinned by hand and would hold the whole group
      // with it. It takes its own pull request, to be paired with a meta chart
      // release that moves the range; the group keeps bumping within range.
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'gsoci.azurecr.io/giantswarm/kagent/helm/kagent',
        'gsoci.azurecr.io/charts/giantswarm/klaus-gateway',
        'gsoci.azurecr.io/charts/giantswarm/model-manager',
        'gsoci.azurecr.io/charts/giantswarm/agentgateway',
        'gsoci.azurecr.io/charts/giantswarm/cluster-manager',
        'gsoci.azurecr.io/charts/giantswarm/kserve-llmisvc-crd',
        'gsoci.azurecr.io/charts/giantswarm/kserve-llmisvc-resources',
        'gsoci.azurecr.io/charts/giantswarm/kserve-runtime-configs',
        'gsoci.azurecr.io/charts/giantswarm/agent-manager',
        'gsoci.azurecr.io/charts/giantswarm/agent-platform-operator',
        'gsoci.azurecr.io/charts/giantswarm/skill-manager',
      ],
      matchUpdateTypes: [
        'major',
      ],
      groupName: null,
    },
    {
      // On a 0.x child the minor is the breaking boundary the meta chart's range
      // stops at (cluster-manager 0.35.x against >=0.22.0 <0.35.0), so it leaves
      // the group like a major does.
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'gsoci.azurecr.io/charts/giantswarm/cluster-manager',
        'gsoci.azurecr.io/charts/giantswarm/kserve-llmisvc-crd',
        'gsoci.azurecr.io/charts/giantswarm/kserve-llmisvc-resources',
        'gsoci.azurecr.io/charts/giantswarm/kserve-runtime-configs',
        'gsoci.azurecr.io/charts/giantswarm/agent-platform-operator',
        'gsoci.azurecr.io/charts/giantswarm/skill-manager',
      ],
      matchCurrentVersion: '/^0\\./',
      matchUpdateTypes: [
        'minor',
      ],
      groupName: null,
    },
    {
      matchDatasources: ['docker'],
      matchPackageNames: ['gsoci.azurecr.io/charts/giantswarm/cluster-manager'],
      versioning: 'semver',
      allowedVersions: '>=0.22.0 <0.35.0',
    },
    {
      // The developer portal pin follows the major the fleet base's backstage
      // range and the portal shapes' line (testdata/consumption/*.portal.yaml)
      // follow; a pin past it fails the test. It moves with them.
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'gsoci.azurecr.io/charts/giantswarm/backstage',
      ],
      allowedVersions: '/^2\\./',
    },
    {
      matchDatasources: ['docker'],
      matchPackageNames: ['gsoci.azurecr.io/charts/giantswarm/mcp-capi'],
      versioning: 'semver',
      allowedVersions: '<=0.6.30',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'gsoci.azurecr.io/charts/giantswarm/mcp-kubernetes',
      ],
      allowedVersions: '/^1\\./',
      overrideDatasource: 'github-releases',
      overridePackageName: 'giantswarm/mcp-kubernetes',
      extractVersion: '^v(?<version>.*)$',
      minimumReleaseAge: '0 days',
      ignoreUnstable: true,
    },
    {
      matchDatasources: ['docker'],
      matchPackageNames: ['gsoci.azurecr.io/charts/giantswarm/mcp-prometheus'],
      versioning: 'semver',
      allowedVersions: '<=0.12.7',
      minimumReleaseAge: '0 days',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'gsoci.azurecr.io/charts/giantswarm/mcp-capi',
      ],
      overrideDatasource: 'github-releases',
      overridePackageName: "{{{replace 'gsoci.azurecr.io/charts/' '' packageName}}}",
      extractVersion: '^v(?<version>.*)$',
      minimumReleaseAge: '3 days',
      internalChecksFilter: 'strict',
    },
    {
      // Chart valkey is released from giantswarm/valkey-app.
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'gsoci.azurecr.io/charts/giantswarm/valkey',
      ],
      overrideDatasource: 'github-releases',
      overridePackageName: 'giantswarm/valkey-app',
      extractVersion: '^v(?<version>.*)$',
      minimumReleaseAge: '3 days',
      internalChecksFilter: 'strict',
      versioning: 'semver',
      allowedVersions: '<=0.4.15',
    },
    {
      // The testdata pins are fixtures of the render-consumption test, not what
      // ships: their bumps go in as test(deps), which cuts no release.
      matchFileNames: [
        'render/agentplatform/testdata/**',
      ],
      semanticCommitType: 'test',
    },
  ],
}
