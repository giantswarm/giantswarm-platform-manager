# Rendered by giantswarm-platform-manager, agent-platform definition. Do not edit by hand:
# the next reconcile writes it again from the installation's inputs.
oidc:
  staticClients:
    muster:
      clientSecretRef:
        name: dex-client-muster
        key: secret
    mcpKubernetes:
      clientSecretRef:
        name: dex-client-mcp-kubernetes
        key: secret
    mcpPrometheus:
      clientSecretRef:
        name: dex-client-mcp-prometheus
        key: secret
    mcpCapi:
      clientSecretRef:
        name: dex-client-mcp-capi
        key: secret
    dexK8SAuthenticator:
      trustedPeers:
        - backstage
        - muster-token-exchange-warren
  extraStaticClients:
    - id: kagent
      name: kagent-ui
      secretRef:
        name: dex-client-kagent
        key: secret
      redirectURIs:
        - https://kagent.warren.example.io/oauth2/callback
    - id: backstage
      name: Dev Portal
      redirectURIs:
        - https://portal.gopher.example.io/api/auth/oidc-warren/handler/frame
        - https://portal.warren.example.io/api/auth/oidc-warren/handler/frame
      secretRef:
        name: dex-client-backstage
        key: secret
    - id: muster-token-exchange-warren
      name: gopher token exchange
      secretRef:
        name: dex-client-muster-token-exchange-warren
        key: secret
