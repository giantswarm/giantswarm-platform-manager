# Rendered by giantswarm-platform-manager, agent-platform definition. Do not edit by hand:
# the next reconcile writes it again from the installation's inputs.
global:
  domain: glean.example.io
gitops:
  prereleases: true
components:
  kagent:
    enabled: true
    valuesFromRefs:
      - kind: Secret
        name: kagent-credentials-revision
        valuesKey: revision
        targetPath: oauth2-proxy.podAnnotations.kagent-credentials-revision
  agent-manager:
    enabled: true
    valuesFromRefs:
      - kind: Secret
        name: muster-credentials-revision
        valuesKey: revision
        targetPath: podAnnotations.muster-credentials-revision
  klaus-gateway:
    enabled: true
    valuesFromRefs:
      - kind: Secret
        name: muster-credentials-revision
        valuesKey: revision
        targetPath: podAnnotations.muster-credentials-revision
  cluster-manager:
    enabled: true
    valuesFromRefs:
      - kind: Secret
        name: muster-credentials-revision
        valuesKey: revision
        targetPath: podAnnotations.muster-credentials-revision
  muster:
    valuesFromRefs:
      - kind: Secret
        name: muster-credentials-revision
        valuesKey: revision
        targetPath: muster.oauth.server.existingSecretChecksum
      - kind: Secret
        name: muster-credentials-revision
        valuesKey: revision
        targetPath: muster.oauth.server.storage.valkey.existingSecretChecksum
  valkey:
    valuesFromRefs:
      - kind: Secret
        name: muster-credentials-revision
        valuesKey: revision
        targetPath: valkey.auth.usersExistingSecretChecksum
  model-manager:
    valuesFromRefs:
      - kind: Secret
        name: muster-credentials-revision
        valuesKey: revision
        targetPath: podAnnotations.muster-credentials-revision
  skill-manager:
    valuesFromRefs:
      - kind: Secret
        name: muster-credentials-revision
        valuesKey: revision
        targetPath: podAnnotations.muster-credentials-revision
postgres:
  enabled: true
llmRouting:
  enabled: true
  # Runaway guards, per data-plane replica and per minute. The second bucket is
  # per agent: the kagent identity headers count only from the Substrate egress.
  rateLimits:
    - tokens: 8000000
      unit: Minutes
    - tokens: 5000000
      unit: Minutes
      key: '(source.unverifiedWorkload.namespace == "ate-system" && source.unverifiedWorkload.serviceAccount == "atenet-egress") ? request.headers["x-kagent-agent-namespace"] + "/" + request.headers["x-kagent-agent"] : source.unverifiedWorkload.namespace + "/" + source.unverifiedWorkload.serviceAccount'
kagent:
  oauth2-proxy:
    config:
      existingSecret: kagent-oauth2-proxy-credentials
    extraArgs:
      oidc-extra-audience: dex-k8s-authenticator,kagent,backstage # gitleaks:allow
muster:
  muster:
    oauth:
      mcpClient:
        postLoginRedirectAllowlist:
          - https://agentgateway.glean.example.io/connectors/complete
          - https://portal.example.io/
          - https://portal.glean.example.io/
      server:
        existingSecret: muster-oauth-credentials
        storage:
          valkey:
            existingSecret: muster-valkey-credentials
        preRegisteredClientMetadata:
          - client_id: https://agentgateway.glean.example.io/auth/slack/client.json
            client_name: klaus-gateway
            client_uri: https://github.com/giantswarm/klaus-gateway
            redirect_uris:
              - https://agentgateway.glean.example.io/auth/slack/callback
            grant_types:
              - authorization_code
              - refresh_token
            response_types:
              - code
            token_endpoint_auth_method: none
        dex:
          identityCheckConnectors:
            - giantswarm-ad
            - giantswarm-gazelle-oidc
          allowPrivateIPOIDC: true
        allowPrivateIPClientMetadataHosts:
          - agentgateway.glean.example.io
        allowPrivateIPRedirectURIs: true
        trustedAudiences:
          - dex-k8s-authenticator
          - kagent
          - backstage
  # Giant Swarm's connector admins and workflow editors: the admin groups
  # bound to muster's mcpserver-editor and workflow-editor Roles (the meta chart
  # appends the platform team).
  rbac:
    mcpServerEditor:
      subjects:
        - apiGroup: rbac.authorization.k8s.io
          kind: Group
          name: giantswarm-ad:giantswarm-admins
        - apiGroup: rbac.authorization.k8s.io
          kind: Group
          name: giantswarm-github:giantswarm:giantswarm-admins
    workflowEditor:
      subjects:
        - apiGroup: rbac.authorization.k8s.io
          kind: Group
          name: giantswarm-ad:giantswarm-admins
        - apiGroup: rbac.authorization.k8s.io
          kind: Group
          name: giantswarm-github:giantswarm:giantswarm-admins
gateway:
  jwksEgress:
    enabled: true
extraObjects:
  - apiVersion: gateway.networking.k8s.io/v1beta1
    kind: ReferenceGrant
    metadata:
      name: agentgateway-jwks-dex
      namespace: giantswarm
    spec:
      from:
        - group: agentgateway.dev
          kind: AgentgatewayPolicy
          namespace: agent-platform
      to:
        - group: ""
          kind: Service
          name: dex
agent-platform-mcps:
  agentgateway:
    jwt:
      extraProviders:
        - issuer: https://dex.glean.example.io
          audiences:
            - backstage
          jwks:
            remote:
              backendRef:
                name: dex
                namespace: giantswarm
                port: 5556
              jwksPath: /keys
              cacheDuration: 5m
klausGateway:
  routing:
    store: valkey
  slack:
    enabled: true
    mode: socketmode
    secretName: klaus-gateway-slack-credentials
    dmMode: serve
    channelMode: all
    # The bots whose posts reach an agent's thread context: the input
    # klausGateway.slack.contextBotIDs, read back so a reconcile keeps them.
    contextBotIDs:
      - U0000000003 # Alerting EU
    # The bot names whose posts reach an agent's thread context: the input
    # klausGateway.slack.contextBotNames, read back so a reconcile keeps them.
    contextBotNames:
      - '*-alertmanager' # every installation's Alertmanager
    # The slash command the installation's Slack app declares: the input
    # klausGateway.slack.slashCommand, read back so a reconcile keeps it.
    slashCommand: /swarmgeist-glean
  obo:
    enabled: true
    connectors:
      enabled: true
    existingSecret: klaus-gateway-obo-keys
    musterUrl: https://muster.glean.example.io
    callbackBaseUrl: https://agentgateway.glean.example.io
    storePath: /var/lib/klaus-gateway/obo/links.bolt
    persistence:
      enabled: true
      size: 64Mi
  a2a:
    enabled: true
    defaultAgent: sre-agent
  reviews:
    enabled: true
    audience: klaus-gateway
    allowedCallers:
      - system:serviceaccount:agent-platform:giantswarm-repo-manager
      - system:serviceaccount:marge:marge-bumblebee-sweep
      - system:serviceaccount:agent-platform:giantswarm-platform-manager
cluster-manager:
  installation:
    name: glean
clusterManager:
  networkPolicy:
    egress:
      fqdns:
        - matchName: gsoci.azurecr.io
        - matchPattern: '*.blob.core.windows.net'
networkPolicy:
  mcpBackends:
    runbooks:
      namespace: mcp-runbooks
      ports:
        - 8080
      metrics: true
    tickets:
      namespace: mcp-tickets
      ports:
        - 8080
      podSelector:
        app.kubernetes.io/name: mcp-tickets
      additionalPeers:
        - namespace: envoy-gateway-system
          matchLabels:
            app.kubernetes.io/name: envoy
valkey:
  valkey:
    auth:
      usersExistingSecret: muster-valkey-credentials
      aclUsers:
        default:
          passwordKey: valkey-password
