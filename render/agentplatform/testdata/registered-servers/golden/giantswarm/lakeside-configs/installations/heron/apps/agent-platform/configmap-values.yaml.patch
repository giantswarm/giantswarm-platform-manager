# Rendered by giantswarm-platform-manager, agent-platform definition. Do not edit by hand:
# the next reconcile writes it again from the installation's inputs.
global:
  domain: heron.lakeside.example
components:
  kagent:
    enabled: true
    valuesFromRefs:
      - kind: Secret
        name: kagent-credentials-revision
        valuesKey: revision
        targetPath: oauth2-proxy.podAnnotations.kagent-credentials-revision
  agent-manager:
    enabled: true
    valuesFromRefs:
      - kind: Secret
        name: muster-credentials-revision
        valuesKey: revision
        targetPath: podAnnotations.muster-credentials-revision
  muster:
    valuesFromRefs:
      - kind: Secret
        name: muster-credentials-revision
        valuesKey: revision
        targetPath: muster.oauth.server.existingSecretChecksum
      - kind: Secret
        name: muster-credentials-revision
        valuesKey: revision
        targetPath: muster.oauth.server.storage.valkey.existingSecretChecksum
  valkey:
    valuesFromRefs:
      - kind: Secret
        name: muster-credentials-revision
        valuesKey: revision
        targetPath: valkey.auth.usersExistingSecretChecksum
  model-manager:
    valuesFromRefs:
      - kind: Secret
        name: muster-credentials-revision
        valuesKey: revision
        targetPath: podAnnotations.muster-credentials-revision
  skill-manager:
    valuesFromRefs:
      - kind: Secret
        name: muster-credentials-revision
        valuesKey: revision
        targetPath: podAnnotations.muster-credentials-revision
postgres:
  enabled: true
llmRouting:
  enabled: true
kagent:
  oauth2-proxy:
    config:
      existingSecret: kagent-oauth2-proxy-credentials
    extraArgs:
      oidc-extra-audience: dex-k8s-authenticator,kagent,backstage # gitleaks:allow
muster:
  muster:
    oauth:
      mcpClient:
        tokenExchange:
          allowPrivateIP: true
      server:
        existingSecret: muster-oauth-credentials
        storage:
          valkey:
            existingSecret: muster-valkey-credentials
        trustedAudiences:
          - dex-k8s-authenticator
          - kagent
          - backstage
        trustedPublicRegistrationRedirectURIs:
          - https://agents.runtime.example/identities/oauth2/callback/00000000-0000-4000-8000-00000000000a
          - https://agents.runtime.example/identities/oauth2/callback/00000000-0000-4000-8000-00000000000b
  # Giant Swarm's connector admins and workflow editors: the admin groups
  # bound to muster's mcpserver-editor and workflow-editor Roles (the meta chart
  # appends the platform team).
  rbac:
    mcpServerEditor:
      subjects:
        - apiGroup: rbac.authorization.k8s.io
          kind: Group
          name: giantswarm-ad:giantswarm-admins
        - apiGroup: rbac.authorization.k8s.io
          kind: Group
          name: giantswarm-github:giantswarm:giantswarm-admins
    workflowEditor:
      subjects:
        - apiGroup: rbac.authorization.k8s.io
          kind: Group
          name: giantswarm-ad:giantswarm-admins
        - apiGroup: rbac.authorization.k8s.io
          kind: Group
          name: giantswarm-github:giantswarm:giantswarm-admins
gateway:
  jwksEgress:
    enabled: true
extraObjects:
  - apiVersion: gateway.networking.k8s.io/v1beta1
    kind: ReferenceGrant
    metadata:
      name: agentgateway-jwks-dex
      namespace: giantswarm
    spec:
      from:
        - group: agentgateway.dev
          kind: AgentgatewayPolicy
          namespace: agent-platform
      to:
        - group: ""
          kind: Service
          name: dex
agent-platform-mcps:
  agentgateway:
    jwt:
      extraProviders:
        - issuer: https://dex.heron.lakeside.example
          audiences:
            - backstage
          jwks:
            remote:
              backendRef:
                name: dex
                namespace: giantswarm
                port: 5556
              jwksPath: /keys
              cacheDuration: 5m
valkey:
  valkey:
    auth:
      usersExistingSecret: muster-valkey-credentials
      aclUsers:
        default:
          passwordKey: valkey-password
