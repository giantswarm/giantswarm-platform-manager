# Rendered by giantswarm-platform-manager, agent-platform definition. Do not edit by hand:
# the next reconcile writes it again from the installation's inputs.
oidc:
  staticClients:
    muster:
      clientSecretRef:
        name: dex-client-muster
        key: secret
    mcpKubernetes:
      clientSecretRef:
        name: dex-client-mcp-kubernetes
        key: secret
    mcpPrometheus:
      clientSecretRef:
        name: dex-client-mcp-prometheus
        key: secret
    mcpCapi:
      clientSecretRef:
        name: dex-client-mcp-capi
        key: secret
    dexK8SAuthenticator:
      trustedPeers:
        - backstage
        - muster-token-exchange-kestrel
  extraStaticClients:
    - id: kagent
      name: kagent-ui
      secretRef:
        name: dex-client-kagent
        key: secret
      redirectURIs:
        - https://kagent.kestrel.oakridge.example/oauth2/callback
    - id: backstage
      name: Dev Portal
      redirectURIs:
        - https://portal.kestrel.oakridge.example/api/auth/oidc-kestrel/handler/frame
        - https://portal.example.io/api/auth/oidc-kestrel/handler/frame
      secretRef:
        name: dex-client-backstage
        key: secret
    - id: muster-token-exchange-kestrel
      name: gopher token exchange
      secretRef:
        name: dex-client-muster-token-exchange-kestrel
        key: secret
  customer:
    connectors:
      - id: giantswarm-simple-oidc
        connectorType: oidc
        connectorName: gopher token exchange
        connectorConfig: |
          issuer: https://dex.gopher.example.io
          insecureEnableGroups: true
          clientID: $DEX_CONNECTOR_GIANTSWARM_SIMPLE_OIDC_CLIENT_ID
          clientSecret: $DEX_CONNECTOR_GIANTSWARM_SIMPLE_OIDC_CLIENT_SECRET
          redirectURI: https://dex.kestrel.oakridge.example/callback
          scopes:
            - openid
            - profile
            - email
            - groups
dex:
  envVars:
    - name: DEX_CONNECTOR_GIANTSWARM_SIMPLE_OIDC_CLIENT_ID
      valueFrom:
        secretKeyRef:
          name: dex-connector-giantswarm-simple-oidc
          key: client-id
          optional: true
    - name: DEX_CONNECTOR_GIANTSWARM_SIMPLE_OIDC_CLIENT_SECRET
      valueFrom:
        secretKeyRef:
          name: dex-connector-giantswarm-simple-oidc
          key: client-secret
          optional: true
