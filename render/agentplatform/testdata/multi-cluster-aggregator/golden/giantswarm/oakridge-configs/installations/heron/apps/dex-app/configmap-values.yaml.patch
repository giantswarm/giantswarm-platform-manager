# Rendered by giantswarm-platform-manager, agent-platform definition. Do not edit by hand:
# the next reconcile writes it again from the installation's inputs.
oidc:
  staticClients:
    muster:
      clientSecretRef:
        name: dex-client-muster
        key: secret
    mcpKubernetes:
      clientSecretRef:
        name: dex-client-mcp-kubernetes
        key: secret
    mcpPrometheus:
      clientSecretRef:
        name: dex-client-mcp-prometheus
        key: secret
    mcpCapi:
      clientSecretRef:
        name: dex-client-mcp-capi
        key: secret
    dexK8SAuthenticator:
      trustedPeers:
        - backstage
  extraStaticClients:
    kagent:
      name: kagent-ui
      secretRef:
        name: dex-client-kagent
        key: secret
      redirectURIs:
        - https://kagent.heron.oakridge.example/oauth2/callback
    backstage:
      name: Dev Portal
      redirectURIs:
        - https://portal.kestrel.oakridge.example/api/auth/oidc-heron/handler/frame
      secretRef:
        name: dex-client-backstage
        key: secret
    federation-kestrel:
      name: kestrel federation login
      redirectURIs:
        - https://dex.kestrel.oakridge.example/callback
      secretRef:
        name: dex-client-federation-kestrel
        key: secret
    federation-plover:
      name: plover federation login
      redirectURIs:
        - https://dex.plover.oakridge.example/callback
      secretRef:
        name: dex-client-federation-plover
        key: secret
