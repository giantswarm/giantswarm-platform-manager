# Rendered by giantswarm-platform-manager, agent-platform definition. Do not edit by hand:
# the next reconcile writes it again from the installation's inputs.
global:
  domain: gopher.example.io
components:
  kagent:
    enabled: true
  agent-manager:
    enabled: true
  klaus-gateway:
    enabled: true
  cluster-manager:
    enabled: true
postgres:
  enabled: true
llmRouting:
  enabled: true
kagent:
  providers:
    anthropic:
      model: example-model-medium
      apiKeySecretRef: kagent-anthropic-key
      config:
        baseUrl: http://agentgateway.agent-platform.svc:8081
  modelConfigs:
    - name: example-large
      displayName: Example Large
      provider: Anthropic
      model: example-model-large
      apiKeySecret: kagent-anthropic-key
      apiKeySecretKey: ANTHROPIC_API_KEY
      baseUrl: http://agentgateway.agent-platform.svc:8081
  oauth2-proxy:
    config:
      existingSecret: kagent-oauth2-proxy-credentials
    extraArgs:
      oidc-extra-audience: dex-k8s-authenticator,kagent,portal-client-id-home # gitleaks:allow
  oauth2ProxyIngress:
    additionalPeers:
      - app: example-tunnel-agent
        io.kubernetes.pod.namespace: example-system
muster:
  resources:
    requests:
      memory: 256Mi
    limits:
      memory: 1Gi
  muster:
    oauth:
      mcpClient:
        postLoginRedirectAllowlist:
          - https://portal.example.io/
      server:
        existingSecret: muster-oauth-credentials
        storage:
          valkey:
            existingSecret: muster-valkey-credentials
        dex:
          connectorId: giantswarm-github
        trustedAudiences:
          - dex-k8s-authenticator
          - kagent
          - portal-client-id-home
        trustedIssuers:
          - issuer: https://irsa.gopher.example.io
            jwksUrl: https://irsa.gopher.example.io/keys.json
            allowedAudiences:
              - https://muster.gopher.example.io/mcp
            acceptedTypHeaders:
              - ""
            allowedClaims:
              sub: system:serviceaccount:kagent:*
gateway:
  jwksEgress:
    enabled: true
extraObjects:
  - apiVersion: gateway.networking.k8s.io/v1beta1
    kind: ReferenceGrant
    metadata:
      name: agentgateway-jwks-dex
      namespace: giantswarm
    spec:
      from:
        - group: agentgateway.dev
          kind: AgentgatewayPolicy
          namespace: agent-platform
      to:
        - group: ""
          kind: Service
          name: dex
agent-platform-mcps:
  mcpServers:
    - cluster: gopher
      group: kubernetes
      url: http://mcp-kubernetes.mcp-kubernetes.svc:8080/mcp
      timeout: 30
      auth:
        mode: forward
    - cluster: gopher
      group: prometheus
      url: http://mcp-prometheus.mcp-prometheus.svc:8080/mcp
      timeout: 30
      auth:
        mode: forward
    - cluster: gopher
      group: capi
      url: http://mcp-capi.mcp-capi.svc:8080/mcp
      timeout: 30
      auth:
        mode: forward
    - name: example-tools
      cluster: gopher
      group: example
      url: http://example-tools.agent-platform.svc:8080/mcp
      timeout: 30
      auth:
        mode: forward
    - name: example-issues
      cluster: gopher
      group: issues
      url: http://example-issues.agent-platform.svc:8080/mcp
      timeout: 120
      toolPrefix: issues
      auth:
        mode: oauth
        authorizationServer:
          issuer: https://issues.example.com/oauth
          authorizationEndpoint: https://issues.example.com/oauth/authorize
          tokenEndpoint: https://issues.example.com/oauth/token
          scopes: read
          grantScope: subject
          clientCredentialsSecretRef:
            name: example-oauth-client
            namespace: agent-platform
    - name: example-boards
      cluster: gopher
      group: boards
      url: http://example-boards.agent-platform.svc:8080/mcp
      timeout: 120
      toolPrefix: boards
      auth:
        mode: oauth
        authorizationServer:
          issuer: https://issues.example.com/oauth
          authorizationEndpoint: https://issues.example.com/oauth/authorize
          tokenEndpoint: https://issues.example.com/oauth/token
          scopes: read
          grantScope: subject
          clientCredentialsSecretRef:
            name: example-oauth-client
            namespace: agent-platform
  agentgateway:
    jwt:
      extraProviders:
        - issuer: https://dex.gopher.example.io
          audiences:
            - portal-client-id-home
          jwks:
            remote:
              backendRef:
                name: dex
                namespace: giantswarm
                port: 5556
              jwksPath: /keys
              cacheDuration: 5m
klausGateway:
  routing:
    store: valkey
  agentgatewayRoute:
    enabled: true
    hostname: agentgateway.gopher.example.io
  slack:
    enabled: true
    mode: events
    secretName: klaus-gateway-slack-credentials
    dmMode: serve
    channelMode: allowlist
    channelAllowlist:
      - CEXAMPLE00001
  obo:
    enabled: true
    connectors:
      enabled: true
    existingSecret: klaus-gateway-obo-keys
    musterUrl: https://muster.gopher.example.io
    callbackBaseUrl: https://agentgateway.gopher.example.io
    storePath: /var/lib/klaus-gateway/obo/links.bolt
    persistence:
      enabled: true
      size: 64Mi
  a2a:
    enabled: true
    defaultAgent: example-agent
    saToken:
      enabled: true
      audience: kagent
  reviews:
    enabled: true
    allowedCallers:
      - system:serviceaccount:giantswarm-platform-manager:giantswarm-platform-manager
cluster-manager:
  installation:
    name: gopher
clusterManager:
  networkPolicy:
    workloadClusters:
      fqdns:
        - matchPattern: api.*.gopher.example.io
    egress:
      fqdns:
        - matchName: registry.example.io
valkey:
  valkey:
    auth:
      usersExistingSecret: muster-valkey-credentials
      aclUsers:
        default:
          passwordKey: valkey-password
