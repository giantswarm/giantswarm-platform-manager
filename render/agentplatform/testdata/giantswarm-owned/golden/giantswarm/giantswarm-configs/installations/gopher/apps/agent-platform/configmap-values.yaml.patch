# Rendered by giantswarm-platform-manager, agent-platform definition. Do not edit by hand:
# the next reconcile writes it again from the installation's inputs.
global:
  domain: gopher.example.io
components:
  kagent:
    enabled: true
  agent-manager:
    enabled: true
  klaus-gateway:
    enabled: true
  cluster-manager:
    enabled: true
postgres:
  enabled: true
llmRouting:
  enabled: true
kagent:
  providers:
    anthropic:
      model: example-model-medium
      apiKeySecretRef: kagent-anthropic-key
      config:
        baseUrl: http://agentgateway.agent-platform.svc:8081
  modelConfigs:
    - name: example-large
      displayName: Example Large
      provider: Anthropic
      model: example-model-large
      apiKeySecret: kagent-anthropic-key
      apiKeySecretKey: ANTHROPIC_API_KEY
      baseUrl: http://agentgateway.agent-platform.svc:8081
  oauth2-proxy:
    config:
      existingSecret: kagent-oauth2-proxy-credentials
    extraArgs:
      oidc-extra-audience: dex-k8s-authenticator,kagent,portal-client-id-home # gitleaks:allow
muster:
  resources:
    requests:
      memory: 256Mi
    limits:
      memory: 1Gi
  muster:
    oauth:
      mcpClient:
        postLoginRedirectAllowlist:
          - https://portal.example.io/
      server:
        existingSecret: muster-oauth-credentials
        storage:
          valkey:
            existingSecret: muster-valkey-credentials
        dex:
          connectorId: giantswarm-github
        trustedAudiences:
          - dex-k8s-authenticator
          - kagent
          - portal-client-id-home
        trustedIssuers:
          - issuer: https://irsa.gopher.example.io
            jwksUrl: https://irsa.gopher.example.io/keys.json
            allowedAudiences:
              - https://muster.gopher.example.io/mcp
            acceptedTypHeaders:
              - ""
            allowedClaims:
              sub: system:serviceaccount:kagent:*
agent-platform-mcps:
  mcpServers:
    - cluster: gopher
      group: kubernetes
      url: http://mcp-kubernetes.mcp-kubernetes.svc:8080/mcp
      timeout: 30
      auth:
        mode: forward
    - cluster: gopher
      group: prometheus
      url: http://mcp-prometheus.mcp-prometheus.svc:8080/mcp
      timeout: 30
      auth:
        mode: forward
    - cluster: gopher
      group: capi
      url: http://mcp-capi.mcp-capi.svc:8080/mcp
      timeout: 30
      auth:
        mode: forward
    - name: example-tools
      cluster: gopher
      group: example
      url: http://example-tools.agent-platform.svc:8080/mcp
      timeout: 30
      auth:
        mode: forward
klausGateway:
  agentgatewayRoute:
    enabled: true
    hostname: agentgateway.gopher.example.io
  slack:
    enabled: true
    mode: events
    secretName: klaus-gateway-slack-credentials
    dmMode: serve
    channelMode: allowlist
    channelAllowlist:
      - CEXAMPLE00001
  obo:
    enabled: true
    connectors:
      enabled: true
    existingSecret: klaus-gateway-obo-keys
    musterUrl: https://muster.gopher.example.io
    callbackBaseUrl: https://agentgateway.gopher.example.io
    storePath: /var/lib/klaus-gateway/obo/links.bolt
    persistence:
      enabled: true
      size: 64Mi
  a2a:
    enabled: true
    defaultAgent: example-agent
    saToken:
      enabled: true
      audience: kagent
  reviews:
    enabled: true
    allowedCallers:
      - system:serviceaccount:giantswarm-platform-manager:giantswarm-platform-manager
cluster-manager:
  installation:
    name: gopher
clusterManager:
  networkPolicy:
    workloadClusters:
      fqdns:
        - matchPattern: api.*.gopher.example.io
    egress:
      fqdns:
        - matchName: registry.example.io
valkey:
  valkey:
    auth:
      usersExistingSecret: muster-valkey-credentials
      aclUsers:
        default:
          passwordKey: valkey-password
