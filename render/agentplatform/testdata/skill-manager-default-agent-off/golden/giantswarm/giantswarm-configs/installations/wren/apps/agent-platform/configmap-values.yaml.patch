# Rendered by giantswarm-platform-manager, agent-platform definition. Do not edit by hand:
# the next reconcile writes it again from the installation's inputs.
global:
  domain: wren.example.io
components:
  kagent:
    enabled: true
    valuesFromRefs:
      - kind: Secret
        name: kagent-credentials-revision
        valuesKey: revision
        targetPath: oauth2-proxy.podAnnotations.kagent-credentials-revision
  agent-manager:
    enabled: true
    valuesFromRefs:
      - kind: Secret
        name: muster-credentials-revision
        valuesKey: revision
        targetPath: podAnnotations.muster-credentials-revision
  cluster-manager:
    enabled: true
    valuesFromRefs:
      - kind: Secret
        name: muster-credentials-revision
        valuesKey: revision
        targetPath: podAnnotations.muster-credentials-revision
  default-agent:
    enabled: false
  muster:
    valuesFromRefs:
      - kind: Secret
        name: muster-credentials-revision
        valuesKey: revision
        targetPath: muster.oauth.server.existingSecretChecksum
      - kind: Secret
        name: muster-credentials-revision
        valuesKey: revision
        targetPath: muster.oauth.server.storage.valkey.existingSecretChecksum
  valkey:
    valuesFromRefs:
      - kind: Secret
        name: muster-credentials-revision
        valuesKey: revision
        targetPath: valkey.auth.usersExistingSecretChecksum
  model-manager:
    valuesFromRefs:
      - kind: Secret
        name: muster-credentials-revision
        valuesKey: revision
        targetPath: podAnnotations.muster-credentials-revision
  skill-manager:
    valuesFromRefs:
      - kind: Secret
        name: muster-credentials-revision
        valuesKey: revision
        targetPath: podAnnotations.muster-credentials-revision
postgres:
  enabled: true
llmRouting:
  enabled: true
kagent:
  oauth2-proxy:
    config:
      existingSecret: kagent-oauth2-proxy-credentials
    extraArgs:
      oidc-extra-audience: dex-k8s-authenticator,kagent # gitleaks:allow
muster:
  muster:
    oauth:
      server:
        existingSecret: muster-oauth-credentials
        storage:
          valkey:
            existingSecret: muster-valkey-credentials
        trustedAudiences:
          - dex-k8s-authenticator
          - kagent
cluster-manager:
  installation:
    name: wren
clusterManager:
  networkPolicy:
    workloadClusters:
      provider: aws
    egress:
      fqdns:
        - matchName: gsoci.azurecr.io
        - matchPattern: '*.blob.core.windows.net'
skillManager:
  sources:
    - https://github.com/acme/skills
    - url: https://github.com/acme/more-skills
      ref: main
      path: skills
      readOnly: true
skill-manager:
  github:
    app:
      secretName: acme-skills-app
valkey:
  valkey:
    auth:
      usersExistingSecret: muster-valkey-credentials
      aclUsers:
        default:
          passwordKey: valkey-password
