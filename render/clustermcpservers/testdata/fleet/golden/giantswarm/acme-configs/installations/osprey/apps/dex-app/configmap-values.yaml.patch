# Rendered by giantswarm-platform-manager, cluster-mcp-servers definition. Do not edit by hand:
# the next reconcile writes it again from the installation's inputs.
oidc:
  staticClients:
    mcpKubernetes:
      clientSecretRef:
        name: dex-client-mcp-kubernetes
        key: secret
    mcpPrometheus:
      clientSecretRef:
        name: dex-client-mcp-prometheus
        key: secret
    mcpCapi:
      clientSecretRef:
        name: dex-client-mcp-capi
        key: secret
  giantswarm:
    connectors:
      giantswarm-gopher-oidc:
        connectorType: oidc
        connectorName: gopher
        config:
          issuer: https://dex.gopher.example.io
          insecureEnableGroups: true
          clientID: federation-osprey
          redirectURI: https://dex.osprey.acme.example.test/callback
          scopes:
            - openid
            - profile
            - email
            - groups
            - offline_access
        clientSecretRef:
          name: dex-connector-giantswarm-gopher-oidc
          key: client-secret
  customer:
    connectors:
      acme-simple-oidc:
        connectorType: oidc
        connectorName: harrier
        config:
          issuer: https://dex.harrier.acme.example.test
          insecureEnableGroups: true
          clientID: federation-osprey
          redirectURI: https://dex.osprey.acme.example.test/callback
          scopes:
            - openid
            - profile
            - email
            - groups
            - offline_access
        clientSecretRef:
          name: dex-connector-acme-simple-oidc
          key: client-secret
      acme-kite-oidc:
        connectorType: oidc
        connectorName: kite
        config:
          issuer: https://dex.kite.acme.example.test
          insecureEnableGroups: true
          clientID: federation-osprey
          redirectURI: https://dex.osprey.acme.example.test/callback
          scopes:
            - openid
            - profile
            - email
            - groups
            - offline_access
        clientSecretRef:
          name: dex-connector-acme-kite-oidc
          key: client-secret
