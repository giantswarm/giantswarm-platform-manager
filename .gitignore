# local builds
/giantswarm-platform-manager
/giantswarm-platform-manager-linux-*
/giantswarm-platform-manager-darwin-*
/giantswarm-platform-manager-windows-*
/platformctl
/platformctl-*
/build/
/dist/
# Helm pulls dependency archives here; nothing is committed there.
/helm/*/charts/
# Python bytecode (ATS test runs)
__pycache__/
# editor / OS
.idea/
.vscode/
.DS_Store
# CircleCI go-build writes its ldflags and the architecture list for
# push-to-registries into the checkout before go build; untracked, they would
# mark the build dirty (vcs.modified) and the version +dirty.
/.ldflags
/.platforms
