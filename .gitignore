# local builds
/giantswarm-platform-manager
/giantswarm-platform-manager-linux-*
/giantswarm-platform-manager-darwin-*
/giantswarm-platform-manager-windows-*
/platformctl
/platformctl-*
/build/
/dist/
# Helm pulls dependency archives here; nothing is committed there.
/helm/*/charts/
# Python bytecode (ATS test runs)
__pycache__/
# editor / OS
.idea/
.vscode/
.DS_Store
# CircleCI go-build writes the architecture list for push-to-registries next
# to the binaries, and go-test the ldflags go-build reads; untracked, either
# would mark the build dirty (vcs.modified) and every binary of a release
# would report its version as vX.Y.Z+dirty.
/.platforms
/.ldflags
